# Framework 16 LED Matrix input modules (VID 32ac, PID 0020).
#
# Install with:
#   sudo cp packaging/60-framework-led-matrix.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# The 60- prefix is load-bearing: do not renumber this file above 73.
# /usr/lib/udev/rules.d/73-seat-late.rules is what turns the uaccess tag into an
# ACL, and udev runs rule files in lexical order, so a tag set by a 99- file is
# set after the only rule that reads it. The symptom is a working symlink with
# no permission behind it.
#
# 1. Grant the logged-in user access to the device nodes.
#
# TAG+="uaccess" makes systemd-logind hand an ACL to whoever is sitting at the
# machine, which is why no group membership is needed. GROUP/MODE are the
# fallback for a headless session, where logind grants nothing.
SUBSYSTEM=="tty", ATTRS{idVendor}=="32ac", ATTRS{idProduct}=="0020", MODE="0660", GROUP="uucp", TAG+="uaccess"

# 2. Give each module a stable name.
#
# Both modules report the same USB serial number (FRAKDEBZ0100000000), so they
# can only be told apart by which port they are plugged into. KERNELS is that
# port. These values are for one specific Framework 16 — check yours with:
#
#   udevadm info -a -n /dev/ttyACM0 | grep -m1 'KERNELS=="[0-9]-'
#
# If left and right come out swapped, swap the two KERNELS values below.
#
# Verified by eye on the reference machine: port 1-4.2 is the left-hand module.
# The port numbering does not follow the physical layout, so this cannot be
# derived — it has to be looked at.
SUBSYSTEM=="tty", ATTRS{idVendor}=="32ac", ATTRS{idProduct}=="0020", KERNELS=="1-4.2", SYMLINK+="led-matrix-left"
SUBSYSTEM=="tty", ATTRS{idVendor}=="32ac", ATTRS{idProduct}=="0020", KERNELS=="1-3.3", SYMLINK+="led-matrix-right"
