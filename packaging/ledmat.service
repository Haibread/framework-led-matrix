[Unit]
Description=Framework 16 LED Matrix panels
Documentation=https://github.com/Haibread/framework-led-matrix
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ledmat
# Deliberately no LEFT_SCENE / RIGHT_SCENE / BRIGHTNESS here: anything set
# would override what `ledmat set` last saved, and the panels would forget
# their setup on every restart. Set them only to pin a panel for good.
Environment=LOG_FILTER=info
# The panels are cleared on SIGTERM; give that a moment to reach the modules.
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
